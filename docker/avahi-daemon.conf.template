# mbusd mDNS/DNS-SD announcement - Avahi daemon config
# The entrypoint replaces %INTERFACES% with the container's non-loopback
# network interfaces (comma separated), so the _modbus-tcp._tcp service is
# announced on EVERY connected network, not just the default route one.
[server]
host-name=mbusd
# Announce on every interface that is actually connected in the container.
allow-interfaces=%INTERFACES%
# Don't ever think we are the only mDNS responder on the network; cooperate.
disallow-other-stacks=no
# Publish on point-to-point links (e.g. docker bridge / VPN) too.
allow-point-to-point=yes

[wide-area]
enable-wide-area=no

[publish]
# Publish A + AAAA address records (multi-homed: one record per address).
publish-aaaa-on-ipv4=yes
publish-a-on-ipv6=yes

[reflector]
enable-reflector=no
